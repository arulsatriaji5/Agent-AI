# ------------------------------------------
# Finance Research Dashboard — Environment
# ------------------------------------------

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Groq API Key (fast inference for Llama models)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (access to hundreds of open-source models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Turso Database URL (get from https://turso.tech/app)
TURSO_DATABASE_URL=libsql://your-database.turso.io

# Turso Auth Token
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Cron Secret — protect the cron endpoint (set any random string)
CRON_SECRET=your_cron_secret_here
