# ------------------------------------------
# Finance Research Dashboard Environment
# ------------------------------------------

# Google Gemini API Key 
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq API Key (fast inference for Llama models)
GROQ_API_KEY=

# OpenRouter API Key (access to hundreds of open-source models)
OPENROUTER_API_KEY=

# Turso Database URL (get from https://turso.tech/app)
TURSO_DATABASE_URL=

# Turso Auth Token
TURSO_AUTH_TOKEN=

# Cron Secret  protect the cron endpoint (set any random string)
CRON_SECRET=
